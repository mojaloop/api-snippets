{
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    // audit-ci supports reading JSON, JSONC, and JSON5 config files.
    // Only use one of ["low": true, "moderate": true, "high": true, "critical": true]
    "moderate": true,
    "allowlist": [
        /**
            [11-03-2026] minimatch <11.0.1: potential DoS via globparts amplification.
            Transitive only (minimatch@3.x/5.x via @redocly/openapi-core, browser-sync>resp-modifier,
            eslint-plugin-import, eslint-plugin-node, standard-version>dotgitignore).
            No fixed release on those major lines, and minimatch@11 has a different API.
        **/
        "GHSA-g3hv-75wg-m249"
    ]
}